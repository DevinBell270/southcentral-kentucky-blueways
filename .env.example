# Optional: enables MapTiler WebP raster tiles for the Leaflet basemap.
# If unset, the app falls back to the standard OpenStreetMap PNG tiles.
NEXT_PUBLIC_MAPTILER_API_KEY=

# Optional full override for another browser-safe XYZ tile provider.
# When NEXT_PUBLIC_TILE_URL is set, it takes precedence over MapTiler.
# Example:
# NEXT_PUBLIC_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.webp
# NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; Example Maps &copy; OpenStreetMap contributors
# NEXT_PUBLIC_TILE_MAX_ZOOM=20
# NEXT_PUBLIC_TILE_SUBDOMAINS=a,b,c
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
NEXT_PUBLIC_TILE_MAX_ZOOM=
NEXT_PUBLIC_TILE_SUBDOMAINS=
